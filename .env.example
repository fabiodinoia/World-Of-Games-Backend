# --- Database (choose ONE) -------------------------------------------------
# Preferred: full MongoDB connection string (Atlas or local), WITHOUT a db name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Legacy alternative, used only when MONGODB_URI is empty (builds a mongodb+srv URI):
# USERNAME=<db user>
# PASSWORD=<db password>
# CLUSTER=<cluster host, e.g. cluster0.abcde.mongodb.net>

# Database name (default: worldofgames). Tests append "_Testing".
NAME=worldofgames

# --- Auth ------------------------------------------------------------------
# Secret used to sign JWTs (1h expiry). Use a long random string in production.
SECRET=change-me

# --- Server ----------------------------------------------------------------
# Port to listen on (default 4800; most platforms inject PORT themselves).
PORT=4800
# Comma-separated list of allowed browser origins (default http://localhost:4200).
CORS_ORIGINS=http://localhost:4200
# Set to 1 when running behind a reverse proxy (Render, Railway, Fly, Heroku...)
# so rate limiting uses the real client IP.
# TRUST_PROXY=1

# --- Rate limiting (requests per IP per 15 min) ------------------------------
# RATE_LIMIT_AUTH=30
# RATE_LIMIT_WRITE=200

# --- Seed ------------------------------------------------------------------
# Base path/URL for cover images stored on games (default: assets/covers).
# SEED_IMG_BASE=assets/covers
