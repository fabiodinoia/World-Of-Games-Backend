{
  "name": "world-of-games-api",
  "version": "1.0.0",
  "description": "World of Games REST API (Express, TypeScript, MongoDB)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "jest --coverage --ci --watchAll=false --runInBand",
    "test:watch": "jest --watchAll --runInBand",
    "start": "cross-env DEBUG=WOG* node ./dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node ./dist/index.js",
    "start:mon": "cross-env DEBUG=WOG* nodemon ./dist/index.js",
    "build": "tsc",
    "build:watch": "tsc -w",
    "seed": "npm run build && node ./dist/seed/run.js"
  },
  "keywords": [
    "Node",
    "Server"
  ],
  "author": "Fabio",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.25",
    "@types/inquirer": "^9.0.10",
    "@types/jest": "^29.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^18.14.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-xo": "^0.43.1",
    "eslint-config-xo-typescript": "^0.56.0",
    "jest": "^29.4.3",
    "mongodb-memory-server": "^11.3.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/node": "^18.14.0",
    "bcryptjs": "^2.4.3",
    "commander": "^10.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "debug": "^4.3.4",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "inquirer": "^9.1.4",
    "jest-ts-webcompat-resolver": "^1.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "morgan": "^1.10.0",
    "supertest": "^6.3.3",
    "zod": "^4.1.12"
  },
  "prettier": {
    "singleQuote": true
  }
}
